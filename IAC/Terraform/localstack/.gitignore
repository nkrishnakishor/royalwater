# Terraform state files
*.tfstate
*.tfstate.*
**/.terraform/

# Terraform variables with sensitive data
terraform.tfvars
terraform.tfvars.json

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (optional - some teams commit these)
.terraform.lock.hcl
**/~/

# SSH keys
*.pem
*.pub

# Kubeconfig files
kubeconfig-*.yaml

# Ignore temporary files
*.tmp
*.bak

# Ignore Python files
*.py
*.pyc
*.uv.lock
__pycache__/
*.egg-info/
dist/
build/
.venv/
venv/
aistudio/

# Environment variables
.env
.env.*

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Log files
*.log*


